<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>disable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      MSB3277: Valheim's game assemblies (assembly_valheim.dll, assembly_guiutils.dll) were built
      against older Mono-era facade versions of System.Net.Http/System.IO.Compression than the
      netstandard2.1 SDK's own reference assemblies. Both are compile-time-only facades (never
      copied to the plugin's output), so the conflict is cosmetic - suppress it rather than chase
      an unfixable version mismatch in a third-party game binary.
    -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!--
    Set the VALHEIM_INSTALL_DIR environment variable to override this on machines
    where Valheim isn't installed at the default Steam location below.
  -->
  <PropertyGroup>
    <ValheimInstallDir Condition="'$(VALHEIM_INSTALL_DIR)' != ''">$(VALHEIM_INSTALL_DIR)</ValheimInstallDir>
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>
  </PropertyGroup>

  <!--
    ValheimRadar has a hard dependency on Jotunn (Jotunn.Main.ModGuid, see RadarPlugin.cs) for
    minimap icon sprites - install it via Thunderstore/r2modman like any other plugin. Override
    JotunnDllPath with -p:JotunnDllPath="..." if your mod manager installs it under a different
    plugin folder name.
  -->
  <PropertyGroup>
    <JotunnDllPath Condition="'$(JotunnDllPath)' == ''">$(ValheimInstallDir)\BepInEx\plugins\Jotunn\Jotunn.dll</JotunnDllPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimInstallDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimInstallDir)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(JotunnDllPath)</HintPath>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\Splatform.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.UIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Native SQLite for the pin database (Persistence/). Only the prebuilt native binaries are used -
    no managed assets - and they ship next to ValheimRadar.dll, where SqliteNative.Preload loads them:
    e_sqlite3.dll (Windows x64) and libe_sqlite3.so (Linux x64). SQLite is public domain.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <SqliteNativeFile Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll" />
    <SqliteNativeFile Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\linux-x64\native\libe_sqlite3.so" />
  </ItemGroup>

  <Target Name="CopySqliteNative" AfterTargets="Build">
    <Copy SourceFiles="@(SqliteNativeFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <!-- Override per-machine with -p:ValheimInstallDir="D:\Games\Valheim" instead of editing this file -->
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>
    <ValheimPluginsDir>$(ValheimInstallDir)\BepInEx\plugins</ValheimPluginsDir>
    <!-- Only kill/relaunch the game for local Debug builds, never for Release/CI packaging -->
    <AutoLaunchValheim Condition="'$(AutoLaunchValheim)' == ''">$(Configuration.Contains('Debug'))</AutoLaunchValheim>
  </PropertyGroup>

  <Target Name="CheckJotunnReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(JotunnDllPath)')" Text="Jotunn.dll not found at '$(JotunnDllPath)'. Install Jotunn (Jotunn, the Valheim Library) via Thunderstore/r2modman, or pass -p:JotunnDllPath=&quot;...&quot; to override." />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Error Condition="!Exists('$(ValheimInstallDir)')" Text="ValheimInstallDir '$(ValheimInstallDir)' does not exist. Pass -p:ValheimInstallDir=&quot;...&quot; to override." />

    <MakeDir Directories="$(ValheimPluginsDir)" Condition="!Exists('$(ValheimPluginsDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ValheimPluginsDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(SqliteNativeFile)" DestinationFolder="$(ValheimPluginsDir)" SkipUnchangedFiles="true" ContinueOnError="true" />

    <Exec Command="taskkill /F /IM valheim.exe"
          Condition="'$(AutoLaunchValheim)' == 'true'"
          ContinueOnError="true"
          IgnoreExitCode="true" />

    <Exec Command="start &quot;&quot; &quot;steam://rungameid/892970//-devcommands -console&quot;"
          Condition="'$(AutoLaunchValheim)' == 'true'"
          ContinueOnError="true" />
  </Target>

  <!--
    Builds a Thunderstore-importable zip (manifest.json + icon.png + README.md + the plugin DLL)
    under bin/Thunderstore. manifest.json's version_number is generated from RadarPlugin's
    PluginVersion const at pack time (see Thunderstore/Pack.ps1) rather than duplicated by hand,
    so the Thunderstore/r2modman listing can never silently drift from the version BepInEx loads.
    Usage: dotnet build -c Release -t:ThunderstorePack
    Override the zip's team/namespace prefix with -p:ThunderstoreNamespace="YourTeamName".
    (Named ThunderstorePack, not "Pack" - that name is already claimed by the SDK's built-in
    NuGet packaging target, which would otherwise silently win over ours.)
  -->
  <PropertyGroup>
    <ThunderstoreNamespace Condition="'$(ThunderstoreNamespace)' == ''">HampusToft</ThunderstoreNamespace>
    <ThunderstoreOutDir>$(MSBuildProjectDirectory)\bin\Thunderstore</ThunderstoreOutDir>
  </PropertyGroup>

  <Target Name="ThunderstorePack" DependsOnTargets="Build">
    <MakeDir Directories="$(ThunderstoreOutDir)" Condition="!Exists('$(ThunderstoreOutDir)')" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Thunderstore\Pack.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -TargetPath &quot;$(TargetPath)&quot; -OutDir &quot;$(ThunderstoreOutDir)&quot; -Namespace &quot;$(ThunderstoreNamespace)&quot;" />
  </Target>

</Project>
