<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>disable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Set the VALHEIM_INSTALL_DIR environment variable to override this on machines
    where Valheim isn't installed at the default Steam location below.
  -->
  <PropertyGroup>
    <ValheimInstallDir Condition="'$(VALHEIM_INSTALL_DIR)' != ''">$(VALHEIM_INSTALL_DIR)</ValheimInstallDir>
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>
  </PropertyGroup>

  <!--
    ValheimRadar has a hard dependency on Jotunn (Jotunn.Main.ModGuid, see RadarPlugin.cs) for
    minimap icon sprites - install it via Thunderstore/r2modman like any other plugin. Override
    JotunnDllPath with -p:JotunnDllPath="..." if your mod manager installs it under a different
    plugin folder name.
  -->
  <PropertyGroup>
    <JotunnDllPath Condition="'$(JotunnDllPath)' == ''">$(ValheimInstallDir)\BepInEx\plugins\Jotunn\Jotunn.dll</JotunnDllPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimInstallDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimInstallDir)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(JotunnDllPath)</HintPath>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\Splatform.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Override per-machine with -p:ValheimInstallDir="D:\Games\Valheim" instead of editing this file -->
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>
    <ValheimPluginsDir>$(ValheimInstallDir)\BepInEx\plugins</ValheimPluginsDir>
    <!-- Only kill/relaunch the game for local Debug builds, never for Release/CI packaging -->
    <AutoLaunchValheim Condition="'$(AutoLaunchValheim)' == ''">$(Configuration.Contains('Debug'))</AutoLaunchValheim>
  </PropertyGroup>

  <Target Name="CheckJotunnReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(JotunnDllPath)')" Text="Jotunn.dll not found at '$(JotunnDllPath)'. Install Jotunn (Jotunn, the Valheim Library) via Thunderstore/r2modman, or pass -p:JotunnDllPath=&quot;...&quot; to override." />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Error Condition="!Exists('$(ValheimInstallDir)')" Text="ValheimInstallDir '$(ValheimInstallDir)' does not exist. Pass -p:ValheimInstallDir=&quot;...&quot; to override." />

    <MakeDir Directories="$(ValheimPluginsDir)" Condition="!Exists('$(ValheimPluginsDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ValheimPluginsDir)" SkipUnchangedFiles="false" />

    <Exec Command="taskkill /F /IM valheim.exe"
          Condition="'$(AutoLaunchValheim)' == 'true'"
          ContinueOnError="true"
          IgnoreExitCode="true" />

    <Exec Command="start &quot;&quot; &quot;steam://rungameid/892970//-devcommands -console&quot;"
          Condition="'$(AutoLaunchValheim)' == 'true'"
          ContinueOnError="true" />
  </Target>

</Project>
